# Opsional, untuk profil mysql historis dan profil supabase (DB-01). Demo/test H2 tidak membaca .env.
# Jangan menimpa .env pribadi yang sudah ada. Jangan commit file .env.
# Password H2 demo dapat diganti melalui variabel proses DEMO_LOCAL_PASSWORD.
# File ini memakai format properties: tanpa export dan tanpa tanda kutip.
APP_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apotek
DB_USERNAME=apotek
DB_PASSWORD=ganti_password_lokal
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DB_SSL_MODE=DISABLED
# Hanya untuk pengembangan lokal. Gunakan password sintetis minimal 12 karakter.
DEMO_ENABLED=true
DEMO_PASSWORD=ganti_password_demo_lokal
# Hanya dipakai bila menjalankan MySQL melalui Docker Compose.
DB_ROOT_PASSWORD=ganti_password_root_lokal
# DB-01 profil supabase: isi dari Supabase Project Settings > Database (Session pooler, port 5432).
# Contoh host: aws-0-ap-southeast-1.pooler.supabase.com, user: postgres.<project-ref>. Jangan commit nilai asli.
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.ganti_project_ref
SUPABASE_DB_PASSWORD=ganti_password_database_supabase
SUPABASE_DB_SCHEMA=klinik
SUPABASE_DB_SSLMODE=require
